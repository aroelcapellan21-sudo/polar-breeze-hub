rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lee el rol del usuario autenticado desde Firestore
    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    function esAdmin()     { return request.auth != null && rol() == 'admin'; }
    function esDespacha()  { return request.auth != null && rol() == 'despachador'; }
    function esEncargado() { return request.auth != null && rol() == 'encargado'; }
    function esChofer()    { return request.auth != null && rol() == 'chofer'; }

    // ── Admin: acceso total a todas las colecciones ──────────────────────────
    match /{path=**} {
      allow read, write: if esAdmin();
    }

    // ── config: catálogo de productos, precios y ajustes ─────────────────────
    // Datos de referencia que necesitan las apps de todos los roles (catálogo,
    // tabla de puntos, número de WhatsApp). Lectura para cualquier autenticado;
    // la escritura sigue restringida a admin vía el catch-all de arriba.
    match /config/{doc} {
      allow read: if request.auth != null;
    }

    // config/despacho: aviso de Oliver a BON + hora_retraso del semáforo.
    // Excepción al catch-all admin: el Despachador puede escribir SOLO este doc de
    // config (los demás config/* siguen admin-only). BON lo lee por service account.
    match /config/despacho {
      allow read:  if request.auth != null;
      allow write: if esAdmin() || esDespacha();
    }

    // acuses_despacho: BON (service account) escribe el acuse "leído"; el Hub del
    // Despachador/Admin los lee para mostrar la confirmación del aviso.
    match /acuses_despacho/{id} {
      allow read, write: if esAdmin() || esDespacha();
    }

    // ── usuarios ─────────────────────────────────────────────────────────────
    // Cada usuario lee su propio doc (auth-context necesita leer el rol al iniciar).
    // Encargado y Despachador leen todos (buscan choferes por nombre/ficha).
    // Solo lectura — la escritura sigue restringida a admin vía el catch-all.
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || esEncargado() || esDespacha());
    }

    // ── inventarios/{fecha}/choferes/{ficha} ─────────────────────────────────
    // Encargado: acceso total para registrar y revisar inventarios del día.
    // Chofer: solo lectura de su propia ficha, verificado por email.
    match /inventarios/{fecha}/choferes/{ficha} {
      allow read, write: if esEncargado();
      allow read:        if esChofer() &&
                            request.auth.token.email == ficha + '@chofer.polarbreeze.com';
    }

    // ── Despachador: history · talonario · drivers · session · facturascan · informes_cierre · anomalias_despacho · movimientos_loker ───────
    // Se incluye esAdmin() explícito para que el Hub Admin no dependa solo del
    // catch-all al hacer consultas (list) sobre estas colecciones.
    match /history/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    // talonario: el Encargado también LO LEE (consulta de choferes/despachos). Solo
    // lectura para encargado; la escritura sigue en admin/despachador.
    match /talonario/{id}          { allow read:        if esAdmin() || esDespacha() || esEncargado();
                                      allow write:       if esAdmin() || esDespacha(); }
    match /drivers/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    match /session/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    match /facturascan/{id}        { allow read, write: if esAdmin() || esDespacha(); }
    match /informes_cierre/{id}    { allow read, write: if esAdmin() || esDespacha(); }
    match /anomalias_despacho/{id} { allow read, write: if esAdmin() || esDespacha(); }
    match /movimientos_loker/{id} {
      // Despachador registra salidas del día; Encargado gestiona stock del Loker;
      // Admin lee el stock en el Hub.
      allow read, write: if esAdmin() || esDespacha() || esEncargado();
      // Chofer: solo lectura de sus propios movimientos (su Hub consulta
      // where choferId == su uid). Sin escritura.
      allow read:        if esChofer() && resource.data.choferId == request.auth.uid;
    }

    // ── Encargado + Admin: lotes_loker · codigos_cajas · weight_alerts · pedidos_bon ───────
    match /lotes_loker/{id}       { allow read, write: if esAdmin() || esEncargado(); }
    match /lotes_weight/{id}      { allow read, write: if esAdmin() || esEncargado(); }
    match /codigos_cajas/{codigo} { allow read, write: if esAdmin() || esEncargado(); }
    match /weight_alerts/{id}     { allow read, write: if esAdmin() || esEncargado(); }
    match /pedidos_bon/{id}       { allow read, write: if esAdmin() || esEncargado(); }

    // ── notas_credito: gestionadas desde el Hub Admin (Inventario) ───────────
    match /notas_credito/{id}     { allow read, write: if esAdmin(); }

    // Colecciones no listadas (alertas, logs, etc.) → solo Admin vía catch-all
  }
}
