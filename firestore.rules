rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lee el rol del usuario autenticado desde Firestore
    function rol() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    function esAdmin()     { return request.auth != null && rol() == 'admin'; }
    function esDespacha()  { return request.auth != null && rol() == 'despachador'; }
    function esEncargado() { return request.auth != null && rol() == 'encargado'; }
    function esChofer()    { return request.auth != null && rol() == 'chofer'; }

    // ── Admin: acceso total a todas las colecciones ──────────────────────────
    match /{path=**} {
      allow read, write: if esAdmin();
    }

    // ── config: catálogo de productos, precios y ajustes ─────────────────────
    // Datos de referencia que necesitan las apps de todos los roles (catálogo,
    // tabla de puntos, número de WhatsApp). Lectura para cualquier autenticado;
    // la escritura sigue restringida a admin vía el catch-all de arriba.
    // Excluye 'secrets': si no, esta regla general lo seguiría cubriendo igual
    // (Firestore evalúa TODAS las reglas que apliquen a un doc con OR — no basta
    // con agregar una regla más estricta aparte, hay que excluirlo aquí).
    match /config/{doc} {
      allow read: if request.auth != null && doc != 'secrets';
    }

    // config/secrets: fix S1 (2026-07-05). Antes vivían en config/main
    // (resetPassword, telegramToken, telegramChatId, correoMonitoreo,
    // correoPassword) y CUALQUIER rol autenticado los podía leer. Ahora: SOLO
    // admin, ni siquiera Despachador (la clave de Reset se verifica server-side
    // en /api/verify-reset-password, que lee esto con el service account).
    match /config/secrets {
      allow read, write: if esAdmin();
    }

    // config/despacho: aviso de Oliver a BON + hora_retraso del semáforo.
    // Excepción al catch-all admin: el Despachador puede escribir SOLO este doc de
    // config (los demás config/* siguen admin-only). BON lo lee por service account.
    match /config/despacho {
      allow read:  if request.auth != null;
      allow write: if esAdmin() || esDespacha();
    }

    // acuses_despacho: BON/app-chofer (service account) escriben el acuse "leído";
    // el Encargado lo escribe desde el Hub (cliente). Admin/Despachador los leen.
    match /acuses_despacho/{id} {
      allow read, write: if esAdmin() || esDespacha() || esEncargado();
    }

    // avisos: centro de mensajes. Escribe el Hub (admin/despachador); lo leen los
    // clientes del Hub (incl. Encargado su propia área). BON y app-chofer leen por
    // service account (ignoran reglas).
    match /avisos/{id} {
      allow read:  if esAdmin() || esDespacha() || esEncargado();
      allow write: if esAdmin() || esDespacha();
    }

    // ── usuarios ─────────────────────────────────────────────────────────────
    // Cada usuario lee su propio doc (auth-context necesita leer el rol al iniciar).
    // Encargado y Despachador leen todos (buscan choferes por nombre/ficha).
    // Escritura: admin-only vía el catch-all, salvo la excepción acotada de
    // Encargado sobre inventario_base (ver más abajo).
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || esEncargado() || esDespacha());

      // Fase 1 (plan de conexión, 2026-07-05): Encargado declara el
      // inventario_base del chofer. Acotado por campo — Encargado NUNCA
      // puede tocar role/email/activo ni ningún otro campo de este doc,
      // solo estos dos (el resto de la escritura sigue admin-only vía
      // el catch-all de arriba). Mejora #41 (2026-07-08): Despachador
      // (Oliver) comparte este mismo permiso acotado — reutiliza
      // InventarioChoferesAjuste.tsx desde su propio dashboard.
      allow write: if (esEncargado() || esDespacha()) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['inventario_base', 'inventarioBaseDate']);
    }

    // ── inventarios/{fecha}/choferes/{ficha} ─────────────────────────────────
    // Encargado: acceso total para registrar y revisar inventarios del día.
    // Chofer: solo lectura de su propia ficha, verificado por email.
    match /inventarios/{fecha}/choferes/{ficha} {
      allow read, write: if esEncargado();
      allow read:        if esChofer() &&
                            request.auth.token.email == ficha + '@chofer.polarbreeze.com';
    }

    // ── Despachador: history · talonario · drivers · session · facturascan · informes_cierre · anomalias_despacho · movimientos_loker ───────
    // Se incluye esAdmin() explícito para que el Hub Admin no dependa solo del
    // catch-all al hacer consultas (list) sobre estas colecciones.
    match /history/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    // talonario: el Encargado también LO LEE (consulta de choferes/despachos). Solo
    // lectura para encargado; la escritura sigue en admin/despachador.
    match /talonario/{id}          { allow read:        if esAdmin() || esDespacha() || esEncargado();
                                      allow write:       if esAdmin() || esDespacha(); }
    match /drivers/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    match /session/{id}            { allow read, write: if esAdmin() || esDespacha(); }
    match /facturascan/{id}        { allow read, write: if esAdmin() || esDespacha(); }
    match /informes_cierre/{id}    { allow read, write: if esAdmin() || esDespacha(); }
    match /anomalias_despacho/{id} { allow read, write: if esAdmin() || esDespacha(); }
    match /movimientos_loker/{id} {
      // Despachador registra salidas del día; Encargado gestiona stock del Loker;
      // Admin lee el stock en el Hub.
      allow read, write: if esAdmin() || esDespacha() || esEncargado();
      // Chofer: solo lectura de sus propios movimientos (su Hub consulta
      // where choferId == su uid). Sin escritura.
      allow read:        if esChofer() && resource.data.choferId == request.auth.uid;
    }

    // ── Encargado + Admin: lotes_loker · codigos_cajas · weight_alerts · pedidos_bon ───────
    // lotes_loker y codigos_cajas: Despachador también (mejora #41, 2026-07-08) —
    // Oliver reutiliza RegistroLote.tsx desde su propio dashboard para registrar
    // entradas. weight_alerts/pedidos_bon quedan Encargado-only, no los toca esa mejora.
    match /lotes_loker/{id}       { allow read, write: if esAdmin() || esEncargado() || esDespacha(); }
    match /lotes_weight/{id}      { allow read, write: if esAdmin() || esEncargado(); }
    match /codigos_cajas/{codigo} { allow read, write: if esAdmin() || esEncargado() || esDespacha(); }
    match /weight_alerts/{id}     { allow read, write: if esAdmin() || esEncargado(); }
    match /pedidos_bon/{id}       { allow read, write: if esAdmin() || esEncargado(); }

    // alias_productos: diccionario inteligente de Registro de Lote (mejora #30/#34) —
    // vincula un texto no reconocido de la IA a un producto_id existente; Despachador
    // también (mejora #41) porque reutiliza el mismo RegistroLote.tsx. config/precios
    // en sí sigue admin-only (se escribe vía /api/registrar-producto-nuevo con service
    // account, no desde el cliente).
    match /alias_productos/{clave} { allow read, write: if esAdmin() || esEncargado() || esDespacha(); }

    // facturas_proveedor: recepción de factura fiscal de proveedor (Encargado) —
    // registro fiscal solamente, no toca movimientos_loker/lotes_loker.
    match /facturas_proveedor/{id} { allow read, write: if esAdmin() || esEncargado(); }

    // ── notas_credito: gestionadas desde el Hub Admin (Inventario) ───────────
    match /notas_credito/{id}     { allow read, write: if esAdmin(); }

    // bandeja_despacho: bandeja general del Despachador (Oliver). Encargado/Admin
    // crean notas (y a futuro correcciones de reporte); Despachador las lee y
    // marca leída/resuelta. Sin acceso de Chofer.
    match /bandeja_despacho/{id}  { allow read, write: if esAdmin() || esDespacha() || esEncargado(); }

    // deudas_chofer: deuda registrada contra un chofer por discrepancia de reporte
    // (plan de deuda del chofer, 2026-07-10). La crea app-chofer con service
    // account (bypassa esta regla) — el chofer NUNCA la lee/escribe desde acá,
    // siempre vía su propio backend. Encargado/Despachador la leen y la marcan
    // 'saldada'. Sin acceso de Chofer.
    match /deudas_chofer/{id}     { allow read, write: if esAdmin() || esDespacha() || esEncargado(); }

    // Colecciones no listadas (alertas, logs, etc.) → solo Admin vía catch-all
  }
}
