rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Regla global: requiere autenticación para todo ──────────────────────
    // Sistema interno — todos los usuarios autenticados pueden leer y escribir.
    // Los roles se validan en el código de la app, no aquí.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
