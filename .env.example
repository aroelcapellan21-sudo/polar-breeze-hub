# ══════════════════════════════════════════════════════════════════════════════
# POLAR BREEZE HUB — Plantilla de variables de entorno
# Copiá este archivo como .env.local y completá los valores reales.
#
#   cp .env.example .env.local
#
# ⚠️  NUNCA subas .env.local al repositorio — ya está en .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Firebase (proyecto: polar-breeze) ─────────────────────────────────────────
# Consola: https://console.firebase.google.com/project/polar-breeze/settings/general
NEXT_PUBLIC_FIREBASE_API_KEY=REEMPLAZAR_CON_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=polar-breeze.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=polar-breeze
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=polar-breeze.appspot.com

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Consola: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR_CON_TU_CLAVE

# ── Modo desarrollo ───────────────────────────────────────────────────────────
# Ficha del chofer que se auto-loguea con `npm run dev` (sin contraseña).
# NODE_ENV=development lo activa automáticamente; no cambiar en producción.
NEXT_PUBLIC_DEV_CHOFER_FICHA=0001
